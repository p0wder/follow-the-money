# Copy to .env and fill in. Never commit .env.
# Long-lived token with instagram_basic and pages_read_engagement (hashtag search),
# and ads_read access for the Ad Library API (requires identity confirmation).
META_ACCESS_TOKEN=
# The Instagram business/creator account ID that makes the hashtag queries.
IG_USER_ID=
GRAPH_API_VERSION=v23.0
# Comma-separated ISO country codes for Ad Library searches.
FTM_AD_COUNTRIES=US
# FTM_DB_PATH=data/ftm.sqlite3
